# All Purpose Exam Questioners — server config.
# Copy this file to .env and fill in the values.

# --- AI provider --------------------------------------------------------------
# Used by backend.py to call OpenRouter for question generation.
OPENROUTER_API_KEY=sk-or-...

# --- Database -----------------------------------------------------------------
# PostgreSQL connection string. Examples:
#   postgresql://apeq:apeq@localhost:5432/apeq
#   postgresql://user:pass@db.example.com:5432/apeq?sslmode=require
POSTGRES_DSN=postgresql://apeq:apeq@localhost:5432/apeq

# --- Flask session ------------------------------------------------------------
# Used to sign session cookies. Generate a long random string:
#   python -c "import secrets; print(secrets.token_hex(32))"
# If unset, the server picks a random one at boot — but that invalidates every
# user's session on every restart, so set this for any real use.
FLASK_SECRET_KEY=replace-with-a-long-random-string
